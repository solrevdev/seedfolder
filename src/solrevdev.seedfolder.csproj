<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The published package needs both targets; CI installs both SDKs so it ships both, and SDK 10 alone builds net10.0 only. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">net10.0;net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <!-- Roll-forward does not cross major version boundaries by default, so a
         tool built for one major will not start when only a newer major is
         installed. Without this the tool breaks the day a user moves to a
         runtime we do not target. -->
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>seedfolder</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <Version>1.7.0</Version>
    <Title>solrevdev.seedfolder</Title>
    <Description>.NET Global Tool for .NET 10 and .NET 11 that creates a folder and copies dotfiles into it therefore seeding a folder.</Description>
    <PackageDescription>.NET Global Tool for .NET 10 and .NET 11 that creates a folder and copies dotfiles into it therefore seeding a folder.</PackageDescription>
    <Authors>solrevdev</Authors>
    <Company>solrevdev</Company>
    <RepositoryUrl>https://github.com/solrevdev/seedfolder</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/solrevdev/seedfolder</PackageProjectUrl>
    <PackageReleaseNotes>1.7.0: Targets net10.0 and net11.0 only. Support for net8.0 and net9.0 is dropped because .NET 8 and .NET 9 left support on 10 November 2026. A machine with only the .NET 8 or .NET 9 runtime can no longer install new releases; install .NET 10 or later, or stay on 1.6.2. Full history: https://github.com/solrevdev/seedfolder/releases</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dotnetcore;dotnet;csharp;dotnet-global-tool;dotnet-global-tools;</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="McMaster.Extensions.CommandLineUtils" Version="5.1.0" />
    <PackageReference Include="Figgle" Version="0.6.6" />
    <PackageReference Include="Figgle.Fonts" Version="0.6.6" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Data/dockerignore" />
    <Content Remove="Data/editorconfig" />
    <Content Remove="Data/editorconfig-dotnet" />
    <Content Remove="Data/editorconfig-node" />
    <Content Remove="Data/editorconfig-python" />
    <Content Remove="Data/editorconfig-ruby" />
    <Content Remove="Data/editorconfig-markdown" />
    <Content Remove="Data/editorconfig-universal" />
    <Content Remove="Data/gitattributes" />
    <Content Remove="Data/gitattributes-node" />
    <Content Remove="Data/gitattributes-python" />
    <Content Remove="Data/gitattributes-ruby" />
    <Content Remove="Data/gitattributes-markdown" />
    <Content Remove="Data/gitattributes-universal" />
    <Content Remove="Data/gitignore" />
    <Content Remove="Data/gitignore-universal" />
    <Content Remove="Data/prettierignore" />
    <Content Remove="Data/prettierrc" />
    <Content Remove="Data/omnisharp.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data/dockerignore" />
    <EmbeddedResource Include="Data/editorconfig" />
    <EmbeddedResource Include="Data/editorconfig-dotnet" />
    <EmbeddedResource Include="Data/editorconfig-node" />
    <EmbeddedResource Include="Data/editorconfig-python" />
    <EmbeddedResource Include="Data/editorconfig-ruby" />
    <EmbeddedResource Include="Data/editorconfig-markdown" />
    <EmbeddedResource Include="Data/editorconfig-universal" />
    <EmbeddedResource Include="Data/gitattributes" />
    <EmbeddedResource Include="Data/gitattributes-node" />
    <EmbeddedResource Include="Data/gitattributes-python" />
    <EmbeddedResource Include="Data/gitattributes-ruby" />
    <EmbeddedResource Include="Data/gitattributes-markdown" />
    <EmbeddedResource Include="Data/gitattributes-universal" />
    <EmbeddedResource Include="Data/gitignore" />
    <EmbeddedResource Include="Data/gitignore-universal" />
    <EmbeddedResource Include="Data/prettierignore" />
    <EmbeddedResource Include="Data/prettierrc" />
    <EmbeddedResource Include="Data/omnisharp.json" />
    <EmbeddedResource Include="Data/package.json" />
    <EmbeddedResource Include="Data/index.js" />
    <EmbeddedResource Include="Data/gitignore-node" />
    <EmbeddedResource Include="Data/main.py" />
    <EmbeddedResource Include="Data/gitignore-python" />
    <EmbeddedResource Include="Data/requirements.txt" />
    <EmbeddedResource Include="Data/Gemfile" />
    <EmbeddedResource Include="Data/main.rb" />
    <EmbeddedResource Include="Data/gitignore-ruby" />
    <EmbeddedResource Include="Data/README.md" />
    <EmbeddedResource Include="Data/gitignore-markdown" />
  </ItemGroup>
</Project>
